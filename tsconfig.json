{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": [
        "src/core/*"
      ],
      "@db/*": [
        "src/db/*"
      ],
      "@types/*": [
        "src/types/*"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*",
    "client/src/**/*",
    "electron/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "release"
  ]
}